{
  "name": "fluent-reader",
  "version": "1.3.2",
  "description": "Modern desktop RSS reader",
  "main": "./dist/electron.js",
  "scripts": {
    "build": "webpack --config ./webpack.config.js",
    "electron": "electron ./dist/electron.js",
    "start": "npm run build && npm run electron",
    "format": "prettier --write --list-different .",
    "drizzle:generate": "drizzle-kit generate",
    "update:mercury": "node build/update-mercury.js",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "package-win": "electron-builder -w appx:x64 && electron-builder -w appx:arm64",
    "package-win-ci": "electron-builder -w --x64 -p never",
    "package-mac": "electron-builder --mac --universal",
    "package-mas": "bash build/resignAndPackage.sh",
    "package-linux": "electron-builder --linux --x64 -p never"
  },
  "keywords": [],
  "author": "Haoyuan Liu",
  "license": "BSD-3-Clause",
  "sideEffects": [
    "*.css"
  ],
  "repository": "github:yang991178/fluent-reader",
  "devDependencies": {
    "@fluentui/react": "^8.125.9",
    "@fluentui/react-components": "^9.73.7",
    "@fluentui/react-migration-v8-v9": "^9.10.9",
    "@fluentui/react-shared-contexts": "^9.26.2",
    "@griffel/react": "^1.6.1",
    "@griffel/webpack-plugin": "^4.0.3",
    "@jocmp/mercury-parser": "^3.1.1",
    "@types/lovefield": "^2.1.3",
    "@types/nedb": "^1.8.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.4",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "electron-react-devtools": "^0.5.3",
    "electron-store": "^12.0.0",
    "font-list": "^1.4.2",
    "html-webpack-plugin": "^5.5.3",
    "js-md5": "^0.7.3",
    "lovefield": "^2.1.12",
    "mini-css-extract-plugin": "^2.10.2",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "prettier": "2.3.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl-universal": "^2.2.5",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^4.0.0",
    "rss-parser": "^3.13.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
